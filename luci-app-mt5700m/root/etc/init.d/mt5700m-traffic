#!/bin/sh /etc/rc.common

START=61
STOP=49
USE_PROCD=1

start_service() {
	procd_open_instance main
	procd_set_param command /usr/sbin/mt5700m-traffic daemon
	procd_set_param respawn 5 5 0
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

stop_service() {
	/usr/sbin/mt5700m-traffic flush >/dev/null 2>&1 || true
}
